  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/gateway.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
