}

# ---------------------------------------------------------------- menu principal
# Tecla r: troca o nome de uma sessão (rename-session), como o r do omega do Mac.
renomear() {
  local c=$1 s=$2 novo
  echo; echo "  Sessão: $s ($(servidor_de "$c"), usuário $c)"
  # Mesmo painel do passo do nome da Nova sessão (30/10/2026, pedido do dono: o Renomear caía na pergunta em
  # texto): campo ✎ para digitar e abre na hora (CS_ABRE=1, botoes_abre), com o nome atual como dica.
  botoes_abre renomear "Renomear $s ($(servidor_de "$c")) · digite o novo nome" "|✎|$s|letras, números, - e _|✎" "|↩️|Cancelar||⏎"
  read -rp "Novo nome (Enter = cancelar): " novo || return
  botoes_some
  [[ -n $novo ]] || { MENU_MSG="Nada renomeado."; return; }
  [[ $novo =~ ^[A-Za-z0-9_-]+$ ]] || { MENU_MSG="Nome inválido: '$novo' (letras, números, - e _)."; return; }
  if tm "$c" has-session -t "=$novo" 2>/dev/null; then MENU_MSG="Já existe '$novo' em $c."; return; fi
  # Antes: aba antiga ganha o id pelo nome velho. Depois: a aba troca de nome junto (o attach dela
  # segue na sessão, que só mudou de nome).
  abas_sincroniza
  tm "$c" rename-session -t "=$s" "$novo" </dev/null || { MENU_MSG="✗ Não renomeei $s."; return; }
  MENU_MSG="📝 $s → $novo"
  abas_sincroniza
}

# Painel ao vivo (24/10/2026, pedido do dono: "não ficar esperando o a"): a cada AO_VIVO s a
# tela é refeita num arquivo e só troca na tela se mudou alguma coisa (situação, nome, "há N min",
# script que entrou ou saiu). A escolha é lida tecla a tecla, e o que já foi digitado volta depois
# do redesenho. Aba do CloudShell que ninguém está vendo (sem navegador ligado, ou outra aba na
# frente) não relê nada: cada volta é um sudo e um ssh para o bf e o Mac. $1 = função que desenha,
# $2 = prompt. Enter deixa a linha em ESC; Ctrl-D ou EOF devolvem 1.
AO_VIVO=3
na_tela() {
  [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]] || return 0
  [[ $(tmux display -p -t "$TMUX_PANE" '#{&&:#{session_attached},#{window_active}}' 2>/dev/null) != 0 ]]
}
ao_vivo() {
  local desenha=$1 prompt=$2 tela novo ch buf='' prazo rc
  tela=$(mktemp); novo=$(mktemp)
  ESC=
  while :; do
    # no shell atual: TERMINAIS/SCRIPTS valem para a escolha
    if na_tela && "$desenha" >"$novo" 2>&1 && ! cmp -s "$novo" "$tela"; then
      limpa; cat "$novo"; printf '%s%s' "$prompt" "$buf"; cp "$novo" "$tela"
    fi
    # Botões no navegador a cada volta (a aba que volta para a frente ganha os dela de novo; a página
    # só redesenha se mudou alguma coisa).
    declare -F "${desenha}_botoes" >/dev/null && na_tela && "${desenha}_botoes"
    prazo=$((SECONDS + AO_VIVO))
    while (( SECONDS < prazo )); do
      IFS= read -rsn1 -t 1 ch; rc=$?
      # A cada segundo sem tecla, os botões de novo (27/10/2026, pedido do dono: "não está em tempo real"):
      # voltar para esta aba ou recarregar a página tira o menu do navegador, e esperar a volta de 3 s
      # deixava o ⌥ Tab sem ele. A página ignora o que chegar igual.
      if (( rc > 128 )); then declare -F "${desenha}_botoes" >/dev/null && na_tela && "${desenha}_botoes"; continue
      elif (( rc )); then echo; rm -f "$tela" "$novo"; botoes_some; return 1; fi
      case $ch in
        '') echo; rm -f "$tela" "$novo"; ESC=$buf; botoes_some; return 0 ;;
        $'\x7f'|$'\b') [[ -n $buf ]] && { buf=${buf%?}; printf '\b \b'; } ;;
        $'\x04') [[ -n $buf ]] || { echo; rm -f "$tela" "$novo"; botoes_some; return 1; } ;;
        $'\e') read -rsn5 -t 0.05 _ || true ;;   # seta e afins: descarta a sequência
        [[:print:]]) buf+=$ch; printf '%s' "$ch" ;;
      esac
    done
  done
}

# Tela inicial no visual do omega do Mac (24/10/2026): servidor no topo, colunas, ícones nas teclas,
# Enter = 1. Este servidor, o srv2 e o Mac, um bloco cada. Painel ao vivo (ao_vivo): a
