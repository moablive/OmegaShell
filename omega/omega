menu_sh() {
  local esc e u p_q=', q'
  abas && p_q=
  SH_MSG=
  while true; do
    ao_vivo tela_sh "Número do .sh para rodar, ou t, a, k, x${p_q}: " || return   # Ctrl-D: sai
    esc=$ESC; SH_MSG=
    esc=${esc// /}
    case $esc in
      q|Q|'') abas || return
              [[ -n $esc ]] && SH_MSG="a aba sh é fixa: não fecha" ;;
      a|A) ;;
      t|T) sh_auto ;;
      k|K) echo; sh_senha ;;
      [kK][xX]) sh_senha x ;;
      [xX]*) sh_excluir "${esc:1}" ;;
      *) if e=$(sh_escolha "$esc"); then
           u=${e%%|*}; e=${e#*|}
           sh_abre_aba "${e%%|*}" "$u" && continue
           sh_roda "${e%%|*}" "$u"; pausa "Enter = voltar à lista" || true; continue
         fi
         SH_MSG="Opção inválida: '$esc'" ;;
    esac
