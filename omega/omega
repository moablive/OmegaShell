  printf '\e[1md\e[0m    ❌ FECHAR     encerra uma sessão (d1 = fecha a 1; salva git e docs antes)\n'
  printf '\e[1my\e[0m    ✅ SIM        responde Sim à sessão que pede permissão (y1 = na 1), sem abrir o terminal\n'
  printf '\e[1mx\e[0m    ✖️  NÃO        responde Não (x1 = na 1)\n'
  # No CloudShell a lista dos ~/sh já é a aba fixa sh (26/10/2026, pedido do dono): sem o botão aqui.
  abas || printf '\e[1msh\e[0m   🧾 SH         roda um script .sh deste servidor\n'
  printf '\e[1ma\e[0m    🔄 ATUALIZAR  relê agora (a lista já se atualiza sozinha a cada %s s)\n' "$AO_VIVO"
