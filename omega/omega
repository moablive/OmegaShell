# ✅ Sim / ✖ Não sem abrir o terminal (30/10/2026, ideia do bjornjee/agent-dashboard, pedido do dono): a tecla vai por
# send-keys para a sessão que está pedindo permissão — y e n são os atalhos do próprio diálogo do Claude Code. Só
# quando o estado diz "esperando" (omega-estado ou tela): fora disso a letra cairia no prompt do Claude como texto.
# A tela de Sessões do OmegaShell (pwa/sessoes.js) mostra os dois botões no cartão e digita y<nº>⏎ / x<nº>⏎.
responder() {
  local c=$1 s=$2 k=$3 st=$4
  [[ $st == *esperando* ]] || { MENU_MSG="$s não está esperando você: nada enviado"; return; }
  if tm "$c" send-keys -t "=$s:" -l "$k" </dev/null 2>/dev/null && { sleep 0.2; tm "$c" send-keys -t "=$s:" Enter </dev/null 2>/dev/null; }; then
    MENU_MSG="$([[ $k == y ]] && echo '✅ Sim' || echo '✖ Não') enviado para $s ($(servidor_de "$c"))"
  else MENU_MSG="✗ não consegui falar com $s"; fi
}
menu() {
  local esc i c s ia st att
  MENU_MSG=
  local p_sh='sh, ' p_fim='a ou q'; abas && p_sh= p_fim=a
  while true; do
    ao_vivo tela_menu "Escolha: número da sessão, n, r, d, y, x, ${p_sh}${p_fim} (Enter = 1): " || return   # Ctrl-D: sai
    esc=$ESC; MENU_MSG=
    esc=${esc// /}
    case $esc in
      q|Q) abas || return; MENU_MSG="a aba omega é fixa: não fecha" ;;
      a|A) ;;
      n|N) nova_sessao ;;
      # No CloudShell o sh digitado vai para a aba fixa sh.
      s|S|sh|SH) if abas; then command tmux select-window -t ':=sh' 2>/dev/null || MENU_MSG="a aba sh não está aberta (reabra o CloudShell)"; else menu_sh; fi ;;
      [yYxX]*)
        local op=${esc:0:1} num=${esc:1}
        [[ -n $num ]] || { MENU_MSG="use y<nº> (Sim) ou x<nº> (Não): y1 responde à sessão 1"; continue; }
        i=$(indice "$num" ${#TERMINAIS[@]}) && [[ -n $i ]] || { MENU_MSG="Opção inválida: '$op$num'"; continue; }
        IFS='|' read -r c s ia st att <<< "${TERMINAIS[i]}"
        responder "$c" "$s" "$([[ $op == [yY] ]] && echo y || echo n)" "$st" ;;
      [rRdD]*)
        local op=${esc:0:1} num=${esc:1}
        if [[ -z $num ]]; then
          # Abre na hora (CS_ABRE=1), como os passos da Nova sessão: só "r" ou "d" no celular também cai no painel.
          CS_ABRE=1 sessoes_botoes sessao "$([[ $op == [rR] ]] && echo '📝 Renomear' || echo '❌ Fechar') qual sessão?" "|↩️|Voltar||⏎"
          read -rp "Número da sessão: " num || continue
          [[ -n $num ]] || continue
        fi
        i=$(indice "$num" ${#TERMINAIS[@]}) && [[ -n $i ]] || { MENU_MSG="Opção inválida: '$op$num'"; continue; }
        IFS='|' read -r c s ia st att <<< "${TERMINAIS[i]}"
        if [[ $op == [rR] ]]; then renomear "$c" "$s"; else encerrar "$c" "$s" "$ia" "$st" "$att"; fi ;;
      *)
        [[ -z $esc ]] && esc=1
        i=$(indice "$esc" ${#TERMINAIS[@]}) && [[ -n $i ]] || { MENU_MSG="Opção inválida: '$esc'"; continue; }
        IFS='|' read -r c s ia st att <<< "${TERMINAIS[i]}"
        terminal_abre_aba "$c" "$s" || entrar "$c" "$s" ;;
    esac
  done
}

# ✎ Abrir projeto no editor (28/10/2026, pedido do dono: "o fresh, o melhor de terminal, na tela dividida,
# direto no projeto que estou no chat"). Descobre a pasta do projeto da sessão na máquina dela:
#   Claude → o transcript da sessão (~/.claude/projects/*/<id>.jsonl, o que começou até 5 min depois do processo
#            claude) guarda a pasta de trabalho atual ("cwd" da última linha); se for a home, a raiz git do último
#            arquivo editado;
#   agy    → o id da conversa está no lock aberto pelo processo (presence/<id>.lock) e o transcript dela cita os
#            caminhos: a raiz git do último que não é dotfile nem ~/sh;
#   senão  → a pasta do painel da sessão (pane_current_path).
# Roda num painel dividido da aba (split-window do abas.sh): abre o fresh na pasta; ao sair, o painel fecha.
DESCOBRE_PROJETO=$(cat <<'REMOTO'
s=$1; t=(tmux -L default)
pane=$("${t[@]}" display -p -t "=$s:" '#{pane_current_path}' 2>/dev/null); pid=$("${t[@]}" display -p -t "=$s:" '#{pane_pid}' 2>/dev/null)
dir=
raiz() { local d=$1; while [ -n "$d" ] && [ "$d" != / ]; do [ -d "$d/.git" ] && { echo "$d"; return; }; d=${d%/*}; done; }
if [ -d /proc ] && [ -n "$pid" ]; then
  ia= iapid=
  for p in $(pgrep -P "$pid") $(pgrep -P "$pid" | xargs -r -n1 pgrep -P); do
    c=$(ps -o comm= -p "$p" 2>/dev/null); case $c in claude|agy) ia=$c iapid=$p; break ;; esac
  done
  if [ "$ia" = claude ]; then
    # Início do processo em segundos (etimes, sem depender do idioma do ps/date: no bf o lstart vem em português).
    et=$(ps -o etimes= -p "$iapid" 2>/dev/null | tr -d ' '); ini=$(( $(date +%s) - ${et:-0} )); melhor=; dmin=99999
    for j in "$HOME"/.claude/projects/*/*.jsonl; do
      ts=$(head -c 8000 "$j" 2>/dev/null | grep -oE '"timestamp":"[^"]+"' | head -1 | cut -d'"' -f4); [ -n "$ts" ] || continue
      e=$(date -d "$ts" +%s 2>/dev/null) || continue; d=$((e - ini))
      [ "$d" -ge -5 ] && [ "$d" -le 300 ] && [ "$d" -lt "$dmin" ] && { dmin=$d; melhor=$j; }
    done
    if [ -n "$melhor" ]; then
      cwd=$(tail -c 300000 "$melhor" | grep -oE '"cwd":"[^"]+"' | tail -1 | cut -d'"' -f4)
      [ -n "$cwd" ] && [ "$cwd" != "$HOME" ] && [ -d "$cwd" ] && dir=$cwd
      if [ -z "$dir" ]; then
        for f in $(tail -c 300000 "$melhor" | grep -oE '"file_path":"/[^"]+"' | cut -d'"' -f4 | tac); do r=$(raiz "${f%/*}"); [ -n "$r" ] && { dir=$r; break; }; done
      fi
      # Claude que só usa comandos (cd /srv/... && git ...): a raiz git do último caminho citado, como no agy.
      if [ -z "$dir" ]; then
        for f in $(tail -c 300000 "$melhor" | grep -oE '/(srv|mnt|home|opt)/[A-Za-z0-9_./-]+' | tac); do
          case $f in "$HOME"|"$HOME"/.*|"$HOME"/sh|"$HOME"/sh/*) continue ;; esac
          r=$(raiz "$f"); [ -n "$r" ] && { dir=$r; break; }
        done
      fi
    fi
  elif [ "$ia" = agy ]; then
    conv=$(ls -l /proc/$iapid/fd 2>/dev/null | grep -oE 'presence/[0-9a-f-]+\.lock' | head -1 | sed 's#presence/##; s#\.lock##')
    tr=$HOME/.gemini/antigravity-cli/brain/$conv/.system_generated/logs/transcript.jsonl
    if [ -n "$conv" ] && [ -f "$tr" ]; then
      for f in $(tail -c 300000 "$tr" | grep -oE '/(srv|mnt|home|opt)/[A-Za-z0-9_./-]+' | tac); do
        case $f in "$HOME"/.*|"$HOME"/sh|"$HOME"/sh/*) continue ;; esac
        r=$(raiz "$f"); [ -n "$r" ] && { dir=$r; break; }
      done
    fi
  fi
fi
[ -n "$dir" ] && [ -d "$dir" ] || dir=$pane
echo "$dir"
REMOTO
)
editor() {
  local c=$1 s=$2 dir
  if ! como "$c" bash -c 'command -v fresh >/dev/null' </dev/null 2>/dev/null; then
    printf '\e[33m✗ o fresh não está instalado em %s\e[0m\n' "$(servidor_de "$c")"
    read -rp "Enter = fechar " _ || true; return 1
  fi
  dir=$(como "$c" env -u TMUX bash -s -- "$s" 2>/dev/null <<< "$DESCOBRE_PROJETO") || dir=
  dir=${dir##*$'\n'}
  local re='^/[A-Za-z0-9_./@ -]+$'
  [[ $dir =~ $re && $dir != *..* ]] || dir=$(casa "$c")
  printf '\e[1m✎ fresh em %s (%s)\e[0m\n' "$dir" "$(servidor_de "$c")"
  como "$c" bash -c "cd '$dir' && exec fresh"
}


case ${1:-} in
  sh|s) menu_sh ;;
  # Roda um ~/sh nesta tela e espera o Enter (é o que a aba aberta pelo sh_abre_aba executa).
  # Entra numa sessão tmux da conta (é o que a aba aberta pelo terminal_abre_aba executa).
  entrar)
    contem "${2:-}" "${CONTAS[@]}" "${REMOTOS[@]}" && nome_ok "${3:-}" || { echo "uso: omega entrar <conta|bf|mac> <sessão>" >&2; exit 2; }
    # Na aba: se o attach falhar, o erro fica na tela até o Enter (senão a aba some na hora).
    entrar "$2" "$3" || { echo; read -rp "Enter = fechar a aba " _ || true; } ;;
  rodar)
    nome_ok "${2:-}" && [[ ${3:-$DONO_SH} == @("$DONO_SH"|bf) ]] || { echo "uso: omega rodar <script.sh> [bf]" >&2; exit 2; }
    sh_roda "$2" "${3:-$DONO_SH}"
    # Na aba do CloudShell: OK fecha sozinha (3 s para ver o resultado); erro deixa a aba vermelha
    # e espera o Enter; "continua rodando" (saiu com Ctrl-b d) fecha só a aba.
    case $FIM in
      ok) printf '\e[2m(a aba fecha em 3 s)\e[0m\n'; sleep 3 ;;
      rodando) sleep 2 ;;
      *) [[ -n ${TMUX_PANE:-} ]] && tmux set -w -t "$TMUX_PANE" @cor "#ff5c7a" 2>/dev/null
         echo; read -rp "Enter = fechar a aba " _ || true ;;
    esac ;;
  # Nova sessão direto (27/10/2026, pedido do dono): é o que o "🖥️ Nova sessão…" do ☰ menu e do
  # ☰ CloudShell abre numa aba própria — servidor, Claude ou terminal, nome, e a aba da sessão.
  nova)
    MENU_MSG=
    nova_sessao
    botoes_some
    # Abriu a aba da sessão ou cancelou (Esc no painel = Ctrl-D, 28/10/2026, pedido do dono: o menu em texto
    # não aparece): esta fecha. Erro: a mensagem fica até o Enter.
    if [[ -n $MENU_MSG && $MENU_MSG != ▶* && $MENU_MSG != ↪* ]]; then
      echo; printf '\e[33m%s\e[0m\n' "$MENU_MSG"
      read -rp "Enter = fechar a aba " _ || true
    fi ;;
  # Encerra uma sessão a partir da aba dela (⏻ Encerrar aba do ⌥ Tab, 28/10/2026, pedido do dono: diferente do
  # ✕ Fechar shell, que só fecha o painel e deixa a sessão viva — e a aba volta): abre numa aba própria com a
  # mesma pergunta da tecla d (Claude: Esc, /quit e a Regra 7 no awlsrv; terminal: kill-session). A aba da sessão
  # fecha sozinha quando ela acaba.
  encerrar)
    contem "${2:-}" "${CONTAS[@]}" "${REMOTOS[@]}" && nome_ok "${3:-}" || { echo "uso: omega encerrar <conta|bf|mac> <sessão>" >&2; exit 2; }
    terminais_lista >/dev/null
    ia= st= att=0
    for l in "${TERMINAIS[@]}"; do
      IFS='|' read -r c s ia2 st2 att2 <<< "$l"
      [[ $c == "$2" && $s == "$3" ]] && { ia=$ia2 st=$st2 att=$att2; break; }
    done
    if [[ -z $ia ]]; then
      printf '\e[33m✗ a sessão %s (%s) não está na lista (já fechou?)\e[0m\n' "$3" "$2"
      read -rp "Enter = fechar a aba " _ || true
    else encerrar "$2" "$3" "$ia" "$st" "$att"; botoes_some; fi ;;
  # Painel dividido da aba com o fresh no projeto da sessão (✎ do ⌥ Tab).
  editor)
    contem "${2:-}" "${CONTAS[@]}" "${REMOTOS[@]}" && nome_ok "${3:-}" || { echo "uso: omega editor <conta|bf|mac> <sessão>" >&2; exit 2; }
    editor "$2" "$3" ;;
  ''|menu) menu ;;
  -h|--help|ajuda) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "uso: omega [sh|nova|rodar <script.sh>|entrar <conta> <sessão>|encerrar <conta> <sessão>|editor <conta> <sessão>|--help]" >&2; exit 2 ;;
esac
