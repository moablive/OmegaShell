#!/usr/bin/env bash
# omega-estado — estado das sessões de IA pelos hooks do Claude Code (30/10/2026, pedido do dono, depois de ler o
# bjornjee/agent-dashboard: lá o estado vem do próprio Claude, por hooks, e não da tela). Instalado nos dois
# servidores (Regra 8): /usr/local/bin/omega-estado no awlsrv e ~/.local/bin/omega-estado no bf; ligado em
# ~/.claude/settings.json de cada conta (~/sh/omega-estado-instalar.sh). Fonte: moabinhoia/scripts/servidor/.
#
# Como hook (sem argumentos): lê o JSON do evento no stdin e grava ~/.omega/estado/<sessão tmux>.json —
#   estado: trabalhando | permissao | pergunta | pronto      detalhe: ferramenta ou mensagem
#   tokens_entrada / tokens_saida (somados do transcript a cada Stop, só o trecho novo)
# O omega (LISTA_TMUX) lê esse arquivo em vez de adivinhar pela tela (capture-pane), que fica só de reserva.
# Mudou para permissao/pergunta → aviso no @moabinho_bot (awlnotify, Regra 3; no bf o awlnotify de lá já manda
# --servidor). PostToolUse de Edit/Write → se houver um fresh (daemon) aberto na pasta do projeto, o arquivo
# abre nele ("arquivo vivo"). Tudo que demora vai para segundo plano: o hook precisa responder em ~20 ms.
# Fora do tmux padrão da conta não faz nada (as janelas do OmegaShell são abas, não sessões de IA).
#
#   omega-estado                  hook (stdin)
#   omega-estado ver [sessão]     mostra o(s) estado(s) gravado(s)
#   omega-estado limpar           apaga estados de sessões tmux que não existem mais
set -u
DIR=${OMEGA_ESTADO_DIR:-$HOME/.omega/estado}

case ${1:-} in
  ver)
    shift; for f in "$DIR"/${1:-*}.json; do [[ -f $f ]] || continue; jq -c . "$f"; done; exit 0 ;;
  limpar)
    for f in "$DIR"/*.json; do [[ -f $f ]] || continue; s=$(basename "$f" .json)
      tmux -L default has-session -t "=$s" 2>/dev/null || { rm -f "$f"; echo "apagado: $s"; }; done; exit 0 ;;
  '') ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

[[ -n ${TMUX_PANE:-} && -n ${TMUX:-} ]] || exit 0
sock=${TMUX%%,*}
[[ -n ${OMEGA_ESTADO_QUALQUER_SOCKET:-} || $sock == */tmux-*/default ]] || exit 0
sessao=$(tmux -S "$sock" display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null) || exit 0
[[ $sessao =~ ^[A-Za-z0-9._-]+$ ]] || exit 0

ent=$(cat)
[[ -n $ent ]] || exit 0
campos=$(jq -r '[.hook_event_name, .session_id, .cwd, .tool_name, .notification_type, .message, .transcript_path,
                  (.tool_input.file_path // .tool_input.notebook_path // "")] | map(. // "" | tostring) | join("\u001f")' <<<"$ent" 2>/dev/null) || exit 0
# Separador \x1f e não tab: no read, tabs seguidos (campos vazios) viram UM separador e os valores pulam de lugar.
IFS=$'\x1f' read -r ev sid cwd tool tipo msg transcript arquivo <<<"$campos"

mkdir -p "$DIR"
f=$DIR/$sessao.json
ant='{}'; [[ -f $f ]] && ant=$(cat "$f")
estado_ant=$(jq -r '.estado // ""' <<<"$ant")
estado= det=
case $ev in
  SessionStart)      estado=pronto det="iniciou" ;;
  UserPromptSubmit)  estado=trabalhando ;;
  PreToolUse)        if [[ $tool == AskUserQuestion ]]; then estado=pergunta det="pergunta"; else estado=trabalhando det=$tool; fi ;;
  PostToolUse)       estado=trabalhando det=$tool ;;
  PermissionRequest) estado=permissao det=${tool:-permissão} ;;
  Notification)      case $tipo in
                       permission_prompt)  estado=permissao det=${msg:-permissão} ;;
                       idle_prompt)        estado=pronto ;;
                       elicitation_dialog) estado=pergunta det=${msg:-pergunta} ;;
                       *) exit 0 ;;
                     esac ;;
  Stop)              estado=pronto ;;
  SessionEnd)        rm -f "$f"; exit 0 ;;
  *) exit 0 ;;
esac
agora=$(date +%s)

# Tokens: a cada Stop soma o trecho novo do transcript (de transcript_pos até o fim); nunca relê o arquivo todo.
tin=$(jq -r '.tokens_entrada // 0' <<<"$ant"); tout=$(jq -r '.tokens_saida // 0' <<<"$ant"); pos=$(jq -r '.transcript_pos // 0' <<<"$ant")
if [[ $ev == Stop && -n $transcript && -f $transcript ]]; then
  tam=$(stat -c %s "$transcript" 2>/dev/null || echo 0)
  (( tam < pos )) && pos=0
  if (( tam > pos )); then
    IFS=$'\t' read -r a b < <(tail -c +$((pos + 1)) "$transcript" | jq -rs '
      [.[] | select(.type == "assistant") | .message.usage // empty]
      | [ (map((.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)) | add // 0),
          (map(.output_tokens // 0) | add // 0) ] | @tsv' 2>/dev/null) || a=0 b=0
    tin=$(( tin + ${a:-0} )); tout=$(( tout + ${b:-0} )); pos=$tam
  fi
fi

avisado=$(jq -r '.avisado // 0' <<<"$ant")
avisar=0
if [[ $estado == permissao || $estado == pergunta ]] && [[ $estado_ant != "$estado" ]] && (( agora - avisado > 120 )); then
  avisar=1; avisado=$agora
fi

jq -n --argjson ant "$ant" --arg sessao "$sessao" --arg host "$(hostname -s)" --arg sid "$sid" --arg estado "$estado" \
      --arg det "$det" --arg cwd "$cwd" --arg tr "$transcript" --arg ev "$ev" --argjson tin "$tin" --argjson tout "$tout" \
      --argjson pos "$pos" --argjson agora "$agora" --argjson avisado "$avisado" '
  $ant + {sessao: $sessao, servidor: $host, claude_sessao: $sid, estado: $estado, detalhe: $det, evento: $ev,
          cwd: (if $cwd != "" then $cwd else ($ant.cwd // "") end),
          transcript: (if $tr != "" then $tr else ($ant.transcript // "") end),
          tokens_entrada: $tin, tokens_saida: $tout, transcript_pos: $pos, atualizado: $agora, avisado: $avisado}' \
  > "$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f"

# Daqui para baixo é o que demora: segundo plano, sem segurar o Claude.
if (( avisar )); then
  for a in /usr/local/bin/awlnotify "$HOME/.local/bin/awlnotify"; do [[ -x $a ]] || continue
    ( "$a" --categoria agentes --gravidade aviso "✋ Claude precisa de você — $(hostname -s)/$sessao" \
        "${det:-esperando}$( [[ -n $cwd ]] && printf '\nprojeto: %s' "$cwd")" >/dev/null 2>&1 & ) ; break
  done
fi
if [[ $ev == PostToolUse && $tool =~ ^(Edit|Write|MultiEdit|NotebookEdit)$ && -n $arquivo && -f $arquivo ]] && command -v fresh >/dev/null 2>&1; then
  # Arquivo vivo: o fresh que estiver aberto na pasta do projeto (daemon da pasta) recebe o arquivo que o Claude mexeu.
  ( cd "${cwd:-/}" 2>/dev/null && timeout 5 fresh --cmd daemon open-file "$arquivo" >/dev/null 2>&1 & )
fi
exit 0
